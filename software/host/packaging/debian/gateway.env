# Provision station identity and approved platform access before deployment.
RP1_FACTORY_OPERATOR_TOKEN=
RP1_FACTORY_DATA_ROOT=/var/lib/rp1-factory-hmi
RP1_FACTORY_ALLOWED_CONFIG_ROOT=/etc/rp1-factory-hmi/stations
RP1_FACTORY_ALLOWED_TRAJECTORY_ROOT=/var/lib/rp1-factory-hmi/trajectories
RP1_FACTORY_PLATFORM_URL=
RP1_FACTORY_STATION_ID=
RP1_FACTORY_BENCH_ID=
RP1_FACTORY_MACHINE_TOKEN_FILE=/etc/rp1-factory-hmi/secrets/machine-token
RP1_FACTORY_MACHINE_TOKEN=
PYTHONPATH=/opt/rp1-factory-hmi/motors/lib/python3/site-packages
