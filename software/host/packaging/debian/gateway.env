RP1_FACTORY_OPERATOR_TOKEN=
RP1_FACTORY_DATA_ROOT=/var/lib/rp1-test-hmi
RP1_FACTORY_ALLOWED_CONFIG_ROOT=/etc/rp1-test-hmi/stations
RP1_FACTORY_ALLOWED_TRAJECTORY_ROOT=/var/lib/rp1-test-hmi/trajectories
RP1_FACTORY_PLATFORM_URL=https://localhost:8443
RP1_FACTORY_PLATFORM_MODE=reliability_v1
RP1_FACTORY_PLC_CONFIG=/etc/rp1-test-hmi/plc_cabinet.yaml
RP1_FACTORY_CAN_POLICY=/etc/rp1-test-hmi/can-policy.yaml
RP1_FACTORY_CAN_HELPER_PATH=/usr/lib/rp1-test-hmi/factory-hmi-can-helper
RP1_FACTORY_STATION_ID=
RP1_FACTORY_BENCH_ID=RD-01
RP1_RELIABILITY_SERVICE_KEY_FILE=/etc/rp1-test-hmi/secrets/reliability-service-key
RP1_RELIABILITY_PROFILES=/etc/rp1-test-hmi/reliability_platform.yaml
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
PYTHONPATH=/opt/rp1-test-hmi/motors/lib/python3/site-packages
