#!/bin/sh
set -e

case "${1:-}" in
    remove|deconfigure)
        if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
            systemctl stop rp1-test-uploader.service >/dev/null 2>&1 || true
            systemctl disable rp1-test-uploader.service >/dev/null 2>&1 || true
            systemctl stop rp1-test-gateway.service >/dev/null 2>&1 || true
            systemctl disable rp1-test-gateway.service >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
