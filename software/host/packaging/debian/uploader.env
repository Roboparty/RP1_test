# Factory administrator provisions these values through the approved station
# enrollment page. Do not store a machine token or operator password here.
RP1_FACTORY_PLATFORM_URL=http://dashboard.example.invalid:8080
RP1_FACTORY_STATION_ID=
RP1_FACTORY_MACHINE_TOKEN_FILE=/etc/rp1-factory-hmi/secrets/machine-token

# Optional unattended service account. Interactive desktop login remains
# memory-only and is preferred for attributable submissions.
RP1_FACTORY_PLATFORM_USERNAME=
RP1_FACTORY_PLATFORM_PASSWORD_FILE=/etc/rp1-factory-hmi/secrets/platform-password
