#!/bin/sh
set -e

case "${1:-}" in
    remove|purge)
        if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
            systemctl daemon-reload >/dev/null 2>&1 || true
            systemctl reset-failed rp1-test-gateway.service >/dev/null 2>&1 || true
        fi
        ;;
esac

# /var/lib/rp1-test-hmi is intentionally retained, including test records.
exit 0
